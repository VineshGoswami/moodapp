{
  "version": 2,
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    { "src": "frontend/index.html", "use": "@vercel/static" },
    { "src": "frontend/app.js", "use": "@vercel/static" },
    { "src": "frontend/style.css", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/app.js", "dest": "/frontend/app.js" },
    { "src": "/style.css", "dest": "/frontend/style.css" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
